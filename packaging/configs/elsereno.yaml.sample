# elsereno.yaml, operator config for the elsereno daemon
# (serve verb). Lives at /etc/elsereno/elsereno.yaml when
# the deb/rpm package is installed.
#
# Every key has a default (`elsereno config show` prints them all);
# uncomment and edit only what you need, then check the file with
#   elsereno config lint --config /etc/elsereno/elsereno.yaml
# A key that does not exist is an error (exit 78). Durations are text
# (30s, 2m0s), never a bare number. Keys that nothing reads yet are left
# out here; MANUAL section 13 lists them.

# Postgres pool and TLS. The connection itself comes from DATABASE_URL.
# For a remote host set tls_required to always.
# database:
#   max_conns: 10
#   tls_required: auto   # auto | always | disable

# HTTP server timeouts of serve. Zero means the built-in default; a
# negative value is refused.
# web:
#   read_header_timeout: 5s
#   read_timeout: 30s
#   write_timeout: 30s
#   idle_timeout: 2m0s

# Scan concurrency, read by scan and by serve's dashboard scans.
# scanner:
#   max_concurrent_targets: 100
#   max_concurrent_per_host: 1   # one probe at a time per host, kind to ICS

# OIDC, required for serve on a non-loopback address.
# auth:
#   oidc:
#     issuer: "https://idp.example/"
#     audience: "elsereno"
#     jwks_url: "https://idp.example/.well-known/jwks.json"

# scope.yaml is not configured here: pass it with --scope (see
# elsereno-scope(5) for the commands that take it). Without --scope no
# scope applies.
